# PDF Chat Bot Configuration
# Copy this file to .env and modify as needed

# Flask Configuration
DEBUG=True
SECRET_KEY=change-this-secret-key-in-production
FLASK_ENV=development

# File Upload Configuration
MAX_FILE_SIZE=104857600  # 100MB in bytes
UPLOAD_FOLDER=pdfs
PROCESSED_DATA_FOLDER=processed_data

# AI Model Configuration
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
CLIP_MODEL=ViT-B/32

# Database Configuration
DATABASE_PATH=knowledge_base.db

# Processing Configuration
MAX_CONTEXT_RADIUS=100  # Pixels for finding text context around images
MIN_IMAGE_SIZE=50       # Minimum image size to process (pixels)
OCR_LANGUAGE=eng        # Tesseract OCR language

# Search Configuration
DEFAULT_TOP_K=10        # Default number of search results
MIN_SCORE_THRESHOLD=0.2 # Minimum similarity score for results

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=pdf_chatbot.log